      "agent_type": "frontend",
      "source": "review C1: Claude Code trims the path and writes to <drive>:/frontend/x.md; the hook must not resolve ' ' as a directory"
    },
    {
      "name": "c02-fe-tilde-traversal",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "~/../frontend/x.md", "content": "" },
      "agent_type": "frontend",
      "source": "review C1: Claude Code expands ~ to the home directory"
    },
    {
      "name": "c03-fe-msys-drive-form",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "/c/../frontend/x.md", "content": "" },
      "agent_type": "frontend",
      "source": "review C1: on Windows Claude Code rewrites /c/ to C:\\; elsewhere it is an absolute path outside the repo"
    },
    {
      "name": "c04-fe-relative-resolves-against-session-cwd",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",

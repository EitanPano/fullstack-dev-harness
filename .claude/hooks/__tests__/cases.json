      "tool_input": { "file_path": ".claude/settings.json", "content": "" },
      "agent_type": "",
      "source": "plan 001 review focus 2: docs say agent_type may be an empty string outside a subagent"
    },
    {
      "name": "m05-no-role-is-interactive",
      "hook": "boundary",
      "expect": "allow",
      "tool_name": "Write",
      "tool_input": { "file_path": "backend/x.ts", "content": "" },
      "source": "audit keep: the main session is unrestricted by this hook"
    },
    {
      "name": "m06-no-project-dir-falls-back-to-payload-cwd",
      "hook": "boundary",
      "expect": "allow",
      "tool_name": "Write",
      "tool_input": { "file_path": "{{root}}/frontend/src/a.ts", "content": "" },
      "agent_type": "frontend",
      "env": { "CLAUDE_PROJECT_DIR": "" },
      "cwd": "{{root}}",
      "source": "plan 001 review focus 3: without CLAUDE_PROJECT_DIR the root is payload.cwd, never the hook's own cwd"
    },
    {
      "name": "m07-agent-type-wins-over-env",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Edit",
      "tool_input": { "file_path": "frontend/src/a.ts", "old_string": "a", "new_string": "b" },
      "agent_type": "qa",
      "env": { "AGENT_ROLE": "frontend" },
      "source": "plan 001: agent_type takes precedence over AGENT_ROLE"
    },
    {
      "name": "m08-no-path-field-blocks",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "content": "" },

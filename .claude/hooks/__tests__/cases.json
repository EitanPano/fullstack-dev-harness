      "agent_type": "frontend",
      "source": "review I2: the boundary hook is wired for Edit|Write|MultiEdit|NotebookEdit only; the Bash write channel is Phase 1 #6"
    },
    {
      "name": "i01-destructive-env-prefix-no-leak",
      "hook": "destructive",

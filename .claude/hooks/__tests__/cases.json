      "tool_input": { "file_path": "backend/x.ts", "content": "" },
      "agent_type": "frontend",
      "source": "audit MECH-01: the role arrives as agent_type, no env var involved"
    },
    {
      "name": "m02-subdir-cwd-allowed-path",

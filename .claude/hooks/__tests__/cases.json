      "agent_type": "frontend",
      "cwd": "{{root}}/backend",
      "source": "review C1: the file tools resolve relative paths against the session cwd (payload.cwd), which a Bash cd moves"
    },
    {
      "name": "c05-fe-trailing-whitespace",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "frontend/x.ts ", "content": "" },
      "agent_type": "frontend",
      "source": "review C1: non-canonical spelling is refused rather than reinterpreted"
    },
    {
      "name": "c06-fe-other-drive",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "Z:/frontend/x.ts", "content": "" },
      "agent_type": "frontend",
      "source": "plan 001 review focus 4: another drive is outside every lane and must not throw"
    },
    {
      "name": "c07-fe-unc-path",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "//srv/share/frontend/x.ts", "content": "" },
      "agent_type": "frontend",
      "source": "plan 001 review focus 4: a UNC path is outside every lane"
    },
    {
      "name": "p01-proto-role-blocks-cleanly",
      "hook": "boundary",
      "expect": "block",
      "tool_name": "Write",
      "tool_input": { "file_path": "frontend/x.ts", "content": "" },
      "agent_type": "__proto__",
      "source": "review M3: a prototype-named role must be refused as unknown, not by crashing"
    },
    {
      "name": "r01-boundary-not-invoked-for-bash",
      "hook": "boundary",
      "expect": "allow",
      "tool_name": "Bash",

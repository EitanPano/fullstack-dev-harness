{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Guardrail wiring. Claude Code only reads hook and permission config from this file; a hook script in .claude/hooks/ that is not listed here never runs. See AGENTS.md. Hooks use exec form (node + args: no shell, cwd-independent through ${CLAUDE_PROJECT_DIR}) with onFailure: block, so a hook that crashes, times out or cannot start blocks the call instead of letting it through. permissions.deny is a second, prefix-matched layer that Claude Code evaluates regardless of what the hooks return; the hooks see whole command strings and catch what a prefix cannot. MCP servers are not pre-approved: add a .mcp.json and approve it once, deliberately. show-instruction-guidance.mjs is no guardrail: it shows .claude/instruction-files.md once per session in place of the first Edit or Write of a harness prompt (if takes one rule, so one handler per tool), and its SessionStart entry re-arms it after a compaction or /clear.",
  "permissions": {
    "allow": [
      "Bash(bun install*)",
      "Bash(bun run *)",
      "Bash(bun test*)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(uv run poe *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(node scripts/bootstrap.mjs*)",
      "Bash(node scripts/verify.mjs*)",
      "Bash(node scripts/readme.mjs*)",
      "Bash(node scripts/loop-stats.mjs*)",
      "Bash(node scripts/guidance.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add --intent-to-add*)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose ps*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.local)",
      "Read(**/.dev.vars.preview)",
      "Read(**/.dev.vars.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Read(~/.wrangler/**)",
      "Read(**/xdg.config/.wrangler/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "PowerShell(Remove-Item -Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(*DROP TABLE*)",
      "PowerShell(*DROP DATABASE*)"
    ],
    "ask": [
      "Bash(node scripts/harness-update.mjs*)",
      "Bash(*wrangler*deploy*)",
      "Bash(*wrangler*publish*)",
      "Bash(*wrangler*login*)",
      "Bash(*wrangler*secret*)",
      "Bash(*wrangler*delete*)",
      "Bash(*wrangler*rollback*)",
      "Bash(*wrangler*--remote*)",
      "Bash(*wrangler*time-travel*)",
      "Bash(*wrangler*versions*)",
      "Bash(*wrangler*tail*)",
      "PowerShell(*wrangler*deploy*)",
      "PowerShell(*wrangler*publish*)",
      "PowerShell(*wrangler*login*)",
      "PowerShell(*wrangler*secret*)",
      "PowerShell(*wrangler*delete*)",
      "PowerShell(*wrangler*rollback*)",
      "PowerShell(*wrangler*--remote*)",
      "PowerShell(*wrangler*time-travel*)",
      "PowerShell(*wrangler*versions*)",
      "PowerShell(*wrangler*tail*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-file-access.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-bash.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-agent-boundaries.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/show-instruction-guidance.mjs"],
            "if": "Edit(/**/*.md)",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/show-instruction-guidance.mjs"],
            "if": "Write(/**/*.md)",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/show-instruction-guidance.mjs", "--reset"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
